{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Sachlich",
  "worktree": {
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/tools/dirigent/cockpit.ps1\" -StatusLine",
    "padding": 0,
    "refreshInterval": 5
  },
  "permissions": {
    "additionalDirectories": [
      "C:\\Users\\phili\\FL-Studio"
    ],
    "defaultMode": "dontAsk",
    "allow": [
      "Bash",
      "Bash(*)",
      "PowerShell",
      "PowerShell(*)",
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "Glob",
      "Grep",
      "LS",
      "Agent",
      "Skill",
      "ToolSearch",
      "Monitor",
      "TaskStop",
      "TaskOutput",
      "TaskList",
      "CronCreate",
      "CronDelete",
      "CronList",
      "ScheduleWakeup",
      "SendMessage",
      "ListAgents",
      "PushNotification",
      "SendUserFile",
      "WebFetch",
      "WebSearch",
      "Artifact",
      "AskUserQuestion",
      "EnterPlanMode",
      "ExitPlanMode",
      "EnterWorktree",
      "ExitWorktree",
      "LSP",
      "Workflow",
      "ReportFindings",
      "SendFeedback",
      "RemoteTrigger",
      "DesignSync",
      "mcp__codebase-memory-mcp",
      "mcp__context7",
      "mcp__sequential-thinking",
      "mcp__plugin_playwright_playwright",
      "mcp__fl-studio",
      "mcp__claude_ai_Figma"
    ],
    "deny": [
      "PowerShell(Remove-Item:*)",
      "Bash(rm -rf:*)",
      "Bash(git reset --hard:*)",
      "PowerShell(git reset --hard:*)",
      "Bash(git clean:*)",
      "PowerShell(git clean:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/nakama-primer.sh\"",
            "statusMessage": "Nakama-Systemkarte + Live-Stand injizieren..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/git-riegel.sh\""
          }
        ]
      }
    ]
  }
}
