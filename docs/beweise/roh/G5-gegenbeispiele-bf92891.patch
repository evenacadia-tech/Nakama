+// =========================================================================
+// G5-EIGEN-5 — antikorreliert NEBEN korreliert
+// =========================================================================
+//
+// `bootstrap_p` (experiment.rs:1518–1553) ist ZWEISEITIG: es zaehlt
+// `nicht_positiv` und `nicht_negativ` und nimmt das Minimum. Eine stabil
+// NEGATIVE Reihe bekommt damit denselben kleinen p-Wert wie eine stabil
+// positive — und `wiederholbarkeit = 1 - p` belohnt den Gegenbeleg genauso
+// wie den Beleg. `uplift()` klemmt die negative Differenz zusaetzlich auf 0,
+// statt sie als Gegenbeleg zu fuehren.
+#[test]
+fn eigen5_antikorreliert_neben_korreliert() {
+    let b = Buehne::schlank();
+    let mit = adresse(2);   // laeuft MIT dem Master
+    let gegen = adresse(3); // laeuft GEGEN den Master
+    b.anmelden("main", &b.master, "main", Some(0));
+    b.anmelden("sondeM", &mit, "passive_probe", Some(3));
+    b.anmelden("sondeG", &gegen, "passive_probe", Some(4));
+    b.marke(0);
+    b.belege_je_fenster("main", &b.master, 0, 12, 0,
+                        |i| if i % 2 == 1 { 12.0 } else { 6.0 },
+                        (BAND_VON, BAND_BIS));
+    b.belege_je_fenster("sondeM", &mit, 100, 12, 0,
+                        |i| if i % 2 == 1 { 12.0 } else { 6.0 },
+                        (BAND_VON, BAND_BIS));
+    b.belege_je_fenster("sondeG", &gegen, 200, 12, 0,
+                        |i| if i % 2 == 1 { 6.0 } else { 12.0 },
+                        (BAND_VON, BAND_BIS));
+    let befunde = b.befunde();
+    protokoll("EIGEN-5 korrelierte und antikorrelierte Quelle nebeneinander",
+              &befunde);
+    println!("   => starke Befunde: {}", stark(&befunde));
+}
