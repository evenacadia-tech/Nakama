# Python-Bytecode
__pycache__/

# Playwright-MCP-Arbeitsspuren (Snapshots/Konsolenlogs)
.playwright-mcp/

# ST-Map-Zwischenprodukte (NAK-16; in Sekunden regenerierbar: --nur-stmap + konvertiere-stmap.py)
