+// =========================================================================
+// G5-F7 — die Rangdifferenz AM Quantum (Fall 7, M-25, M-26)
+// =========================================================================
+//
+// `getrennt` (hypothese.rs:1210–1228) vergleicht die auf `RANG_QUANTUM`
+// quantisierten Raenge mit `>`. Eine Differenz UNTER dem Quantum ist nach der
+// Quantisierung exakt null — sie trennt nicht. Der Korpus kann das nur mit
+// EXAKT gleichen Eingaben zeigen (sein Gitter ist 0,1 dB und damit rund
+// 300 Quanten grob); dieser Fall setzt die kleinste Stoerung, die ueberhaupt
+// darstellbar ist: 0,1 dB in EINEM weit entfernten Band.
+#[test]
+fn f7_rangdifferenz_am_quantum() {
+    let b = Buehne::schlank();
+    let a = adresse(2);
+    let c = adresse(3);
+    b.anmelden("main", &b.master, "main", Some(0));
+    b.anmelden("sondeA", &a, "passive_probe", Some(3));
+    b.anmelden("sondeC", &c, "passive_probe", Some(4));
+    b.marke(0);
+    b.belege("main", &b.master, 0, 12, 9.0, 0);
+    b.belege("sondeA", &a, 100, 12, 9.0, 0);
+    // C traegt DIESELBE Anhebung im Befundband — plus 0,1 dB in Band 210.
+    // Das senkt seine Bandpassung um wenige Quanten, mehr nicht.
+    for i in 0..12usize {
+        let zeit = BASIS + (i as i64) * FENSTER;
+        let mut wert = grundform();
+        wert["adresse"] = serde_json::to_value(&c).unwrap();
+        wert["evidence_id"] = json!(hex(0x10000 + 200 + i));
+        wert["transport"]["sequence"] = json!(i as u64 + 1);
+        wert["transport"]["project_sample_start"] = json!(zeit);
+        for pfad in ["/baender/werte", "/verteilung/p10/werte",
+                     "/verteilung/p50/werte", "/verteilung/p95/werte"] {
+            if let Some(Value::Array(werte)) = wert.pointer_mut(pfad) {
+                for index in BAND_VON..BAND_BIS {
+                    let alt = werte[index].as_i64().unwrap_or(0);
+                    werte[index] = json!(alt + 90);
+                }
+                let alt = werte[210].as_i64().unwrap_or(0);
+                werte[210] = json!(alt + 1);
+            }
+        }
+        b.c.p1("sondeC", &serde_json::to_vec(&wert).unwrap());
+    }
+    let befunde = b.befunde();
+    protokoll("F7 kleinste darstellbare Rangstoerung (0,1 dB in Band 210)",
+              &befunde);
+    println!("   => starke Befunde: {}", stark(&befunde));
+    if befunde.len() >= 2 {
+        let d = befunde[0].confidence.score - befunde[1].confidence.score;
+        println!("   => Rangdifferenz = {d:.9} = {:.1} RANG_QUANTUM", d / 1e-6);
+    }
+}
