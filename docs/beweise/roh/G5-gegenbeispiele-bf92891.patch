+// =========================================================================
+// G5-F9 — INTENT-AENDERUNG und RUECKNAHME NACH der Zustellung (Fall 9)
+// =========================================================================
+//
+// Das Interleaving WAEHREND der Rechnung misst bereits
+// `sonde014_verdrahtung.rs::intent_und_ruecknahme_waehrend_der_rechnung`.
+// Hier steht die andere Reihenfolge: der Befund ist schon zugestellt und
+// steht auf READY TO SEND, DANN erst kommt das Veto beziehungsweise die
+// Rücknahme — ohne dass ein neuer Beleg eine Rechnung auslöst.
+#[test]
+fn f9_veto_und_ruecknahme_nach_der_zustellung() {
+    // ── (a) Intent-Veto nach der Zustellung ────────────────────────────
+    let b = Buehne::schlank();
+    let sonde = adresse(2);
+    b.anmelden("main", &b.master, "main", Some(0));
+    b.anmelden("sonde0", &sonde, "passive_probe", Some(3));
+    b.marke(0);
+    b.belege("main", &b.master, 0, 12, 9.0, 0);
+    b.belege("sonde0", &sonde, 100, 12, 9.0, 0);
+    let vorher = b.befunde();
+    protokoll("F9a vor dem Veto", &vorher);
+    assert_eq!(stark(&vorher), 1, "die Buehne traegt wirklich einen READY-Befund");
+
+    // Der User schuetzt die Quelle — ohne neuen Beleg.
+    let veto = json!({
+        "type": "intent_update",
+        "adresse": b.master,
+        "session_epoch": b.master.session_epoch,
+        "vollstaendig": true,
+        "bestand_revision": 1,
+        "intents": [{
+            "quelle_id": sonde.instance_id,
+            "rolle": "geschuetzt",
+            "revision": 1,
+            "herkunft": "user",
+            "konfidenz": 1.0
+        }]
+    });
+    assert!(b.c.intent_update_json("main", &serde_json::to_vec(&veto).unwrap()));
+    let nachher = b.befunde();
+    protokoll("F9a nach dem Veto `geschuetzt` (kein neuer Beleg)", &nachher);
+    println!("   => starke Befunde: {}", stark(&nachher));
+    let sicht = b.snapshot();
+    println!("   => findings im Snapshot: {}",
+             sicht["findings"].as_array().map(Vec::len).unwrap_or(0));
+    for f in sicht["findings"].as_array().cloned().unwrap_or_default() {
+        println!("      snapshot: quelle=..{} klasse={} zustand={}",
+                 &f["candidate_source"].as_str().unwrap_or("")[30..],
+                 f["confidence"]["class"], f["zustand"]);
+    }
+
+    // ── (b) Ruecknahme einer Evidenz nach der Zustellung ───────────────
+    let d = Buehne::schlank();
+    let sonde = adresse(2);
+    d.anmelden("main", &d.master, "main", Some(0));
+    d.anmelden("sonde0", &sonde, "passive_probe", Some(3));
+    d.marke(0);
+    d.belege("main", &d.master, 0, 12, 9.0, 0);
+    d.belege("sonde0", &sonde, 100, 12, 9.0, 0);
+    let vorher = d.befunde();
+    assert_eq!(stark(&vorher), 1, "auch hier steht ein READY-Befund");
+    let getroffen = d.c.invalidierung_wegen_intervention_fuer_link(
+        "sonde0",
+        BASIS + 5 * FENSTER,
+        BASIS + 5 * FENSTER + 1,
+    );
+    println!("   => zurueckgenommene Belege: {getroffen}");
+    let nachher = d.befunde();
+    protokoll("F9b nach der Ruecknahme eines Belegs", &nachher);
+    println!("   => starke Befunde: {}", stark(&nachher));
+}
