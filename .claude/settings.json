{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Sachlich",
  "worktree": {
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/tools/dirigent/cockpit.ps1\" -StatusLine",
    "padding": 0,
    "refreshInterval": 5
  },
  "permissions": {
    "additionalDirectories": [
      "C:\\Users\\phili\\FL-Studio"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git restore:*)",
      "Bash(node:*)",
      "Bash(npx playwright:*)",
      "Bash(cargo test:*)",
      "Bash(cargo build:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git rm:*)",
      "PowerShell(git push:*)",
      "PowerShell(git pull:*)",
      "PowerShell(git status:*)",
      "PowerShell(git log:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git show:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(node:*)",
      "PowerShell(cargo test:*)"
    ],
    "ask": [
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "PowerShell(Remove-Item:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/nakama-primer.sh\"",
            "statusMessage": "Nakama-Systemkarte + Live-Stand injizieren..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/git-riegel.sh\""
          }
        ]
      }
    ]
  }
}
