+// =========================================================================
+// G5-EIGEN-3 — die ANTIKORRELIERTE Quelle
+// =========================================================================
+//
+// Der schärfste Fall, den die Klassenwahl (hypothese.rs:1387–1396) zulässt:
+// die Quelle ist im Befundband GENAU DANN laut, wenn der Master dort leise
+// ist. Der bedingte Uplift aus M-19 ist damit NEGATIV — und `uplift()`
+// (:962–967) klemmt ihn auf 0, `koinzidenz()` (:947) klemmt die negative
+// Korrelation ebenfalls auf 0. Ein Gegenbeleg kostet damit genau so viel wie
+// „keine Angabe": nichts.
+#[test]
+fn eigen3_antikorrelierte_quelle() {
+    let b = Buehne::schlank();
+    let sonde = adresse(2);
+    b.anmelden("main", &b.master, "main", Some(0));
+    b.anmelden("sonde0", &sonde, "passive_probe", Some(3));
+    b.marke(0);
+    // Master: ungerade Fenster laut (12 dB), gerade leise (6 dB). Das LETZTE
+    // Fenster (11) ist laut — `masteranomalie` liest nur dieses.
+    b.belege_je_fenster("main", &b.master, 0, 12, 0,
+                        |i| if i % 2 == 1 { 12.0 } else { 6.0 },
+                        (BAND_VON, BAND_BIS));
+    // Sonde: genau umgekehrt.
+    b.belege_je_fenster("sonde0", &sonde, 100, 12, 0,
+                        |i| if i % 2 == 1 { 6.0 } else { 12.0 },
+                        (BAND_VON, BAND_BIS));
+    let befunde = b.befunde();
+    protokoll("EIGEN-3 antikorrelierte Quelle (laut, wenn der Master leise ist)",
+              &befunde);
+    println!("   => starke Befunde: {}", stark(&befunde));
+}
