{
 "id": "nulltest-host",
 "titel": "Der Render des Diagnoseprojekts im Auslieferungszustand ist bitidentisch zur Quelle (Weg R1); Render mit Verarbeitung und ohne Slots brauchen Karte U43",
 "quelle": "Plan S25e (4) Nulltest im echten Host; R-286-3; docs/beweise/NAK-286.md F-17 bis F-20, M-60 bis M-65, M-75",
 "schritte": [
  {"aktion": "system.ping", "erwarte": {"fl_version": {"nicht_leer": true}}},
  {"aktion": "transport.getLength", "erwarte": {"milliseconds": {"min": 1, "roh": true}}},
  {"aktion": "channels.getInfo", "params": {"index": 0, "use_global": false}, "erwarte": {"index": {"gleich": 0}, "name": {"gleich": "Testtrack"}, "volume": {"roh": true}, "volume_db": {"roh": true}}},
  {"aktion": "mixer.getTrackInfo", "params": {"track": 1}, "erwarte": {"volume": {"roh": true}, "volume_db": {"roh": true}}},
  {"aktion": "mixer.getTrackInfo", "params": {"track": 0}, "erwarte": {"volume": {"roh": true}, "volume_db": {"roh": true}}},
  {"aktion": "mixer.getRouting", "params": {"track": 1}, "erwarte": {"routes.*.dest": {"roh": true}, "routes.*.level": {"roh": true}}},
  {"aktion": "lokal.nulltest", "params": {"vergleich": "auslieferung"}},
  {"aktion": "lokal.nulltest", "params": {"vergleich": "verarbeitung_ein", "projekt": "Nakama-Diagnose-Verarbeitung.flp"}},
  {"aktion": "lokal.nulltest", "params": {"vergleich": "ohne_slots", "projekt": "Nakama-Diagnose-Referenz.flp"}}
 ]
}
