{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evenacadia.eq-copilot.measurement.v1",
  "title": "EQ-Copilot Messungs-Vertrag v1 (Startfassung, Plan §8.2)",
  "description": "M0-Startfassung des Measurement-Objekts. Die Spektral-Arrays kommen erst in M1 dazu (LTAS-Mehrfachauflösung §5.10.1); dieses Schema wird dann über metrics_version fortgeschrieben — nie still geändert. Roh-Audio ist hier per Vertrag ausgeschlossen.",
  "type": "object",
  "required": ["schema_version", "measurement_id", "session_id", "profile_id", "target_id", "metrics_version", "sensors", "created_utc"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "measurement_id": { "type": "string", "format": "uuid" },
    "session_id": { "type": "string" },
    "profile_id": { "type": "string" },
    "target_id": { "type": "string" },
    "metrics_version": { "type": "string", "description": "versionierte Startwerte aus Plan §5.10 — Kalibration nur über neue Version" },
    "created_utc": { "type": "string", "format": "date-time" },
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "description": "vom User — untrusted data" },
        "loop_signature": { "type": ["string", "null"] },
        "active_seconds": { "type": "number", "minimum": 0 },
        "project_time_segments": {
          "type": "array",
          "items": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "sensors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sensor_id", "role", "coverage_class"],
        "additionalProperties": false,
        "properties": {
          "sensor_id": { "type": "string" },
          "role": { "enum": ["sensor", "hub", "pre", "post"] },
          "label": { "type": "string" },
          "pair_id": { "type": ["string", "null"] },
          "pair_status": { "enum": ["bewiesen", "pre_post_wahrscheinlich", "unklar", null] },
          "coverage_class": { "enum": ["belastbar", "eingeschraenkt", "nicht_messbar"] },
          "coverage_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
          "samplerate": { "type": "number" },
          "channels": { "type": "integer" },
          "warnings": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "raw_audio": { "const": null, "description": "immer null — Roh-Audio wird weder gespeichert noch übertragen (Plan §0.2/§8.3)" }
  }
}
