+//! **G5 — adversariale Gegenbeispiele (Phasengate G5, 07.09.2026).**
+//!
+//! Dieses Bein ist KEINE Produktzusage und keine Regression. Es ist der
+//! Angriff, den der Gate-Text von G5 ausdrücklich verlangt
+//! (`docs/bauaufteilung-sonden.md`:397–400):
+//!
+//! > „Der Prüfer soll **eine falsche starke Ursachenbehauptung provozieren**
+//! > — korrelierter Distraktor, Parent-Duplikat, verschobene Passage.
+//! > Enthaltung („mehr Daten nötig") ist das gewünschte Ergebnis, nicht ein
+//! > Treffer."
+//!
+//! Es trägt genau die Fälle, die das **Korpusformat nicht ausdrücken kann**
+//! (`eq-copilot/fixtures/p5-korpus/sitzungen.json` kennt je Quelle nur
+//! Anhebung, Fensterzahl, Mixerkanal und Versatz):
+//!
+//! * eine **echte Passage** samt ihrer Randwerte (`experiment_begin` ist ein
+//!   persistenzpflichtiger P0 und braucht einen Store),
+//! * **zwei Master** in einer Sitzung,
+//! * ein **Kanalwechsel zwischen den Fenstern**,
+//! * eine **antikorrelierte** Quelle (Pegel je Fenster),
+//! * **Rücknahme und Intent-Änderung** nach der Rechnung.
+//!
+//! Jeder Fall fährt durch DENSELBEN Produktpfad wie `sonde014_p5_korpus.rs`:
+//! `Coordinator` → `anmelden` → Vollständigkeitsmarke → `c.p1(...)` →
+//! `session_snapshot_json` beziehungsweise `befunde_sicht`. Ein Bein, das
+//! `hypothesen()` direkt riefe, könnte grün sein, während die Verdrahtung
+//! fehlt.
+//!
+//! ⚠️ Die Zusicherungen hier sind **beobachtend**: sie halten fest, was der
+//! Produktpfad heute tut, und markieren im Text, welche davon eine falsche
+//! starke Behauptung ist. Ein `assert`, das die falsche Behauptung als
+//! richtig festschriebe, wäre die zweite Wahrheit.
+
+#![cfg(windows)]
+
+use eqcop_broker::coordinator::{Befundzustand, CauseHypothesis, Coordinator, ManualClock,
+                                Sicherheitsklasse};
+use eqcop_broker::transport::bootstrap::{Adresse, AudioLage, HelloControl, HostAngabe};
+use eqcop_broker::transport::server_v3::Senke;
+use serde_json::{json, Value};
+use std::sync::Arc;
+
+// ── Werkzeug (eigene Kopie, wie in sonde014_nacharbeit1.rs) ──────────────
+
+fn hex(n: usize) -> String {
+    format!("{n:032x}")
+}
+
+fn adresse(instanz: usize) -> Adresse {
+    Adresse {
+        logon_sid: "S-1-5-21-1-2-3-1001".into(),
+        project_binding_id: hex(0x11),
+        session_epoch: hex(0x22),
+        instance_id: hex(instanz),
+        runtime_nonce: hex(0x40 + instanz),
+    }
+}
+
+fn hello(adresse: Adresse, art: &str) -> HelloControl {
+    HelloControl {
+        typ: "hello".into(),
+        connection_kind: "control".into(),
+        protocol: 3,
+        plugin_version: "test".into(),
+        plugin_kind: art.into(),
+        adresse,
+        host: Some(HostAngabe {
+            pid: 4711,
+            name: Some("FL Studio".into()),
+            version: None,
+        }),
+        audio: AudioLage {
+            samplerate: 48_000.0,
+            block_size: 512,
+            channels: 2,
+        },
+    }
+}
+
+fn capabilities() -> Value {
+    json!({
+        "host_context": true, "project_time": true, "fine_automation": false,
+        "double_precision": false, "latency_report": false, "aux_send": false,
+        "aux_return": false, "compare_routing": false, "sidechain": false,
+        "offline_render": false
+    })
+}
+
+fn wurzel() -> std::path::PathBuf {
+    std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+        .parent()
+        .expect("das Repo liegt ueber broker/")
+        .to_path_buf()
+}
+
+fn fixture(name: &str) -> Value {
+    let pfad = wurzel()
+        .join("eq-copilot/fixtures/v3/gueltig")
+        .join(format!("{name}.json"));
+    serde_json::from_slice(&std::fs::read(&pfad).expect("Fixture liegt im Korpus"))
+        .expect("Fixture ist JSON")
+}
+
+/// Dieselben Bänder wie der Korpus (`MANIFEST.json`:`bandfenster`).
+const BAND_VON: usize = 98;
+const BAND_BIS: usize = 102;
+/// Die Transportepoche der committeten Evidenzgrundform.
+const TRANSPORT_EPOCHE: u64 = 17;
+const BASIS: i64 = 44_108_200;
+const FENSTER: i64 = 512;
+
+fn grundform() -> Value {
+    static ROH: std::sync::OnceLock<Value> = std::sync::OnceLock::new();
+    ROH.get_or_init(|| fixture("evidence-snapshot-mit-ereignissen-und-stereo"))
+        .clone()
+}
+
+/// Ein Beleg mit gesetzter Adresse, Projektzeit und Bandanhebung in
+/// `[band.0, band.1)`.
+fn evidenz(a: &Adresse, nr: usize, projekt_start: i64, anhebung_db: f64,
+           band: (usize, usize)) -> Vec<u8> {
+    let mut wert = grundform();
+    wert["adresse"] = serde_json::to_value(a).unwrap();
+    wert["evidence_id"] = json!(hex(0x10000 + nr));
+    wert["transport"]["sequence"] = json!(nr as u64 + 1);
+    wert["transport"]["project_sample_start"] = json!(projekt_start);
+    for pfad in [
+        "/baender/werte",
+        "/verteilung/p10/werte",
+        "/verteilung/p50/werte",
+        "/verteilung/p95/werte",
+    ] {
+        if let Some(Value::Array(werte)) = wert.pointer_mut(pfad) {
+            for index in band.0..band.1.min(werte.len()) {
+                let alt = werte[index].as_i64().unwrap_or(0);
+                werte[index] = json!(alt + (anhebung_db * 10.0).round() as i64);
+            }
+        }
+    }
+    serde_json::to_vec(&wert).unwrap()
+}
+
+struct TestOrdner(std::path::PathBuf);
+
+impl TestOrdner {
+    fn neu(name: &str) -> Self {
+        let pfad = std::env::temp_dir().join(format!(
+            "nakama-g5-{name}-{}-{}",
+            std::process::id(),
+            uuid::Uuid::new_v4().simple()
+        ));
+        std::fs::create_dir_all(&pfad).unwrap();
+        Self(pfad)
+    }
+
+    fn db(&self) -> std::path::PathBuf {
+        self.0.join(eqcop_broker::store::STORE_DATEINAME)
+    }
+}
+
+impl Drop for TestOrdner {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+/// Der gemeinsame Harnisch: ein `Coordinator` (auf Wunsch mit Store) und
+/// beliebig viele angemeldete Instanzen.
+struct Buehne {
+    c: Arc<Coordinator>,
+    master: Adresse,
+    #[allow(dead_code)]
+    writer: Option<eqcop_broker::store::StoreWriter>,
+    #[allow(dead_code)]
+    ordner: Option<TestOrdner>,
+}
+
+impl Buehne {
+    /// Ohne Store — genügt für alles ausser `experiment_begin`.
+    fn schlank() -> Self {
+        Self {
+            c: Arc::new(Coordinator::mit_uhr(
+                Arc::new(ManualClock::default()),
+                hex(0xbeef),
+            )),
+            master: adresse(1),
+            writer: None,
+            ordner: None,
+        }
+    }
+
+    /// Mit echtem Store — `experiment_begin` ist ein persistenzpflichtiger P0.
+    fn mit_store(name: &str) -> Self {
+        let ordner = TestOrdner::neu(name);
+        let mut k = eqcop_broker::store::StoreKonfiguration::fuer_pfad(ordner.db());
+        k.remote_volume_override = Some(false);
+        let writer = eqcop_broker::store::StoreWriter::starten(k);
+        assert!(!writer.ist_degradiert(), "{:?}", writer.handle().sicht());
+        let c = Coordinator::mit_store(Arc::new(ManualClock::default()), hex(0xbeef), &writer);
+        Self {
+            c: Arc::new(c),
+            master: adresse(1),
+            writer: Some(writer),
+            ordner: Some(ordner),
+        }
+    }
+
+    fn anmelden(&self, link: &str, a: &Adresse, art: &str, mixer: Option<i64>) {
+        let h = hello(a.clone(), art);
+        let ausgang = self.c.control_hello_registrieren(link, &h);
+        assert!(ausgang.angenommen, "{:?}", ausgang.grund);
+        let _ = self.c.resync_bestaetigen(link, 0);
+        self.deskriptor(link, a, art, mixer);
+        // Ohne `record_state` nimmt der Broker keinen persistenzpflichtigen
+        // Befehl an - `experiment_begin` waere `record_state_unknown`.
+        let bericht = json!({
+            "type": "state_report",
+            "adresse": a,
+            "dsp_schema_version": 1,
+            "state_revision": 0,
+            "state_hash": "a".repeat(64),
+            "record_state": {"valid": true, "recording": false}
+        });
+        assert!(self
+            .c
+            .state_report_json(link, &serde_json::to_vec(&bericht).unwrap()));
+    }
+
+    /// Setzt (oder ändert) den Deskriptor — der Mixerkanal lebt hier, nicht
+    /// am Beleg. Genau das ist der Hebel des Kanalwechsels.
+    fn deskriptor(&self, link: &str, a: &Adresse, art: &str, mixer: Option<i64>) {
+        let position = if art == "main" { "insert" } else { "post" };
+        let mut d = json!({
+            "adresse": a,
+            "plugin_kind": art,
+            "measurement_position": position,
+            "aussageklasse": "beobachtend",
+            "betrieb": "active",
+            "label": "G5-Quelle",
+            "capabilities": capabilities(),
+            "frische": {"letzter_kontakt_ms": 10, "stale": false}
+        });
+        if let Some(index) = mixer {
+            d["host_mixer_index"] = json!(index);
+        }
+        assert!(self.c.descriptor_setzen(link, d));
+    }
+
+    /// M-86/NR-01: der Vollbestand MIT Marke, bevor gerechnet wird.
+    fn marke(&self, revision: i64) {
+        let wert = json!({
+            "type": "intent_update",
+            "adresse": self.master,
+            "session_epoch": self.master.session_epoch,
+            "vollstaendig": true,
+            "bestand_revision": revision
+        });
+        self.c.p1("main", &serde_json::to_vec(&wert).unwrap());
+    }
+
+    /// Belege mit konstanter Anhebung, ein Projektfenster je Beleg.
+    fn belege(&self, link: &str, a: &Adresse, ab_nr: usize, anzahl: usize,
+              anhebung_db: f64, ab_fenster: i64) {
+        self.belege_je_fenster(link, a, ab_nr, anzahl, ab_fenster, |_| anhebung_db,
+                               (BAND_VON, BAND_BIS));
+    }
+
+    /// Belege mit einer Anhebung, die vom Fensterindex abhängt.
+    fn belege_je_fenster(
+        &self,
+        link: &str,
+        a: &Adresse,
+        ab_nr: usize,
+        anzahl: usize,
+        ab_fenster: i64,
+        anhebung: impl Fn(usize) -> f64,
+        band: (usize, usize),
+    ) {
+        for i in 0..anzahl {
+            let zeit = BASIS + (ab_fenster + i as i64) * FENSTER;
+            self.c
+                .p1(link, &evidenz(a, ab_nr + i, zeit, anhebung(i), band));
+        }
+    }
+
+    fn befunde(&self) -> Vec<CauseHypothesis> {
+        self.c
+            .befunde_sicht(&self.master.project_binding_id, &self.master.session_epoch)
+    }
+
+    fn snapshot(&self) -> Value {
+        serde_json::from_slice(
+            &self
+                .c
+                .session_snapshot_json(&self.master.project_binding_id,
+                                       &self.master.session_epoch),
+        )
+        .expect("Snapshot ist JSON")
+    }
+
+    /// Eine benannte Passage über den PRODUKTPFAD (`experiment_begin`, P0).
+    ///
+    /// `von_fenster`/`bis_fenster` sind Fensterindizes ab `BASIS`.
+    fn passage(&self, command: usize, experiment: usize, passage_nr: usize,
+               von_fenster: i64, bis_fenster: i64, quellen: &[&Adresse]) -> String {
+        let mut wert = fixture("experiment_begin");
+        wert["kopf"]["ziel"] = serde_json::to_value(&self.master).unwrap();
+        wert["kopf"]["command_id"] = json!(hex(command));
+        wert["kopf"]["base_revision"] = json!(0);
+        wert["experiment_id"] = json!(hex(experiment));
+        let passage_id = hex(0x5000 + passage_nr);
+        wert["passage"]["passage_id"] = json!(passage_id);
+        wert["passage"]["projekt_von"] = json!(BASIS + von_fenster * FENSTER);
+        wert["passage"]["projekt_bis"] = json!(BASIS + bis_fenster * FENSTER);
+        wert["passage"]["transport_epoch"] = json!(TRANSPORT_EPOCHE);
+        let ids: Vec<String> = quellen.iter().map(|a| a.instance_id.clone()).collect();
+        let klassen: Vec<String> = quellen.iter().map(|_| "insert".to_string()).collect();
+        wert["passage"]["aktive_quellen"] = json!(ids);
+        wert["passage"]["messpunktklassen"] = json!(klassen);
+        let antwort = Senke::p0(&*self.c, "main", &serde_json::to_vec(&wert).unwrap())
+            .expect("experiment_begin wird beantwortet");
+        let ack: Value = serde_json::from_slice(&antwort).unwrap();
+        assert_eq!(ack["ergebnis"], "angewandt",
+                   "die Passage entsteht wirklich: {ack:?}");
+        passage_id
+    }
+}
+
+/// Eine Zeile je Befund — das Protokoll, aus dem der Bericht liest.
+fn protokoll(titel: &str, befunde: &[CauseHypothesis]) {
+    println!("── {titel} ──");
+    if befunde.is_empty() {
+        println!("   (KEIN BEFUND — der Produktpfad schweigt)");
+    }
+    for b in befunde {
+        let r = b.rang;
+        println!(
+            "   quelle=..{} klasse={:?} zustand={:?} ursache={:?} claim={:?} score={:.6}",
+            &b.candidate_source[30..],
+            b.confidence.klasse,
+            b.zustand,
+            b.ursachenklasse,
+            b.claim_class,
+            b.confidence.score
+        );
+        println!(
+            "     rang: bandpassung={:.6} koinzidenz={:.6} uplift={:.6} \
+             intent={:.6} wiederholbarkeit={:.6} routing={:.6}",
+            r.bandpassung, r.koinzidenz, r.uplift, r.intent_relevanz,
+            r.wiederholbarkeit, r.routingqualitaet
+        );
+        println!(
+            "     passage={:?} evidence_ids={} alternatives={:?} ausschluesse={:?}",
+            b.passage_id,
+            b.evidence_ids.len(),
+            b.alternatives.iter().map(|a| a[26..].to_string()).collect::<Vec<_>>(),
+            b.ausschluesse
+                .iter()
+                .map(|a| (a.candidate_source[30..].to_string(), a.grund.wire()))
+                .collect::<Vec<_>>()
+        );
+        println!("     likely_cause={:?}", b.likely_cause);
+    }
+}
+
+fn stark(befunde: &[CauseHypothesis]) -> usize {
+    befunde
+        .iter()
+        .filter(|b| b.confidence.klasse == Sicherheitsklasse::Hoch
+            && b.zustand == Befundzustand::ReadyToSend)
+        .count()
+}
+
+// =========================================================================
+// G5-F5 — die ECHTE Passage und ihre Randwerte (Fall 5, M-23, M-67)
+// =========================================================================
+//
+// Der P5-Korpus fährt seine Sitzungen OHNE Passage: `aufnahmen_sammeln`
+// liest sie aus `stand.experimente.juengste_passage_im_projekt`
+// (hypothese_verdrahtung.rs:237), und ohne `experiment_begin` gibt es
+// keine. Damit steht der Passagenriegel (`gate()` :838–854) im ganzen
+// Korpus NIE unter Last — auch nicht in der Sitzung `verschobene_passage`,
+// die am Alignment gegen den MASTER fällt (gate :828) und nicht an der
+// Passage.
+#[test]
+fn f5_passagenrandwerte() {
+    // `bis_fenster` der Passage, dazu was wir erwarten.
+    for (bis, was) in [
+        (12i64, "Passage deckt alle zwoelf Fenster"),
+        (11, "GENAU EIN Fenster liegt ausserhalb"),
+        (8, "Randwert: genau GATE_MINDEST_FENSTER Fenster in der Passage"),
+        (7, "ein Fenster UNTER dem Randwert"),
+    ] {
+        let b = Buehne::mit_store(&format!("f5-{bis}"));
+        let sonde = adresse(2);
+        b.anmelden("main", &b.master, "main", Some(0));
+        b.anmelden("sonde0", &sonde, "passive_probe", Some(3));
+        b.marke(0);
+        b.passage(0x900 + bis as usize, 0x910 + bis as usize, bis as usize,
+                  0, bis, &[&b.master, &sonde]);
+        b.belege("main", &b.master, 0, 12, 9.0, 0);
+        b.belege("sonde0", &sonde, 100, 12, 9.0, 0);
+        let befunde = b.befunde();
+        protokoll(&format!("F5 Passage [0,{bis}) — {was}"), &befunde);
+        println!("   => starke Befunde: {}", stark(&befunde));
+    }
+
+    // Die Passage liegt VOLLSTAENDIG hinter den Belegen: ein Fenster, das
+    // exakt am Anfang der Passage endet, zaehlt NICHT (halboffen).
+    let b = Buehne::mit_store("f5-daneben");
+    let sonde = adresse(2);
+    b.anmelden("main", &b.master, "main", Some(0));
+    b.anmelden("sonde0", &sonde, "passive_probe", Some(3));
+    b.marke(0);
+    b.passage(0x940, 0x941, 40, 12, 24, &[&b.master, &sonde]);
+    b.belege("main", &b.master, 0, 12, 9.0, 0);
+    b.belege("sonde0", &sonde, 100, 12, 9.0, 0);
+    let befunde = b.befunde();
+    protokoll("F5 Passage [12,24) — Belege enden exakt am Passagenanfang", &befunde);
+    println!("   => starke Befunde: {}", stark(&befunde));
+}
+
+// =========================================================================
+// G5-F5b — GLEICHE passage_id, verschobenes Zeitfenster (Fall 5)
+// =========================================================================
+//
+// `begin_anwenden_locked` (experiment_verdrahtung.rs:445–476) legt eine
+// bekannte Passage NICHT neu an: „Sie wird nur beim ERSTEN Versuch angelegt,
+// der sie nennt; ein zweiter Versuch derselben Passage schreibt sie nicht
+// um." Trägt der zweite Versuch dieselbe `passage_id` mit ANDEREM Fenster,
+// misst der Broker weiter gegen das alte.
+#[test]
+fn f5b_gleiche_passage_id_verschobenes_fenster() {
+    let b = Buehne::mit_store("f5b");
+    let sonde = adresse(2);
+    b.anmelden("main", &b.master, "main", Some(0));
+    b.anmelden("sonde0", &sonde, "passive_probe", Some(3));
+    b.marke(0);
+    // Erst die Passage [0,12).
+    let p1 = b.passage(0x950, 0x951, 50, 0, 12, &[&b.master, &sonde]);
+    // Dann DIESELBE Kennung mit dem Fenster [12,24).
+    let p2 = b.passage(0x952, 0x953, 50, 12, 24, &[&b.master, &sonde]);
+    assert_eq!(p1, p2, "beide Versuche nennen dieselbe passage_id");
+    // Die Belege liegen im ZWEITEN, verschobenen Fenster.
+    b.belege("main", &b.master, 0, 12, 9.0, 12);
+    b.belege("sonde0", &sonde, 100, 12, 9.0, 12);
+    let befunde = b.befunde();
+    protokoll("F5b gleiche passage_id, Fenster verschoben von [0,12) auf [12,24)",
+              &befunde);
+    println!("   => starke Befunde: {}", stark(&befunde));
+    println!("   => sichtbare passage_id: {:?}",
+             befunde.first().and_then(|f| f.passage_id.clone()));
+}
+
+// =========================================================================
+// G5-F8 — ZWEI MASTER in einer Sitzung (Fall 8)
+// =========================================================================
+//
+// `aufnahmen_sammeln` (hypothese_verdrahtung.rs:216) schreibt
+// `master = Some(profil)` ohne Prüfung, ob schon einer da ist. Die
+// Schlüssel sind nach `instance_id` sortiert — der LETZTE `main` gewinnt,
+// der erste verschwindet ganz: er wird auch nicht Kandidat.
+#[test]
+fn f8_zwei_master_mit_widersprechendem_befundband() {
+    let b = Buehne::schlank();
+    let master_a = adresse(1);
+    let master_b = adresse(9);
+    let sonde = adresse(2);
+    b.anmelden("main", &master_a, "main", Some(0));
+    b.anmelden("main2", &master_b, "main", Some(1));
+    b.anmelden("sonde0", &sonde, "passive_probe", Some(3));
+    b.marke(0);
+    // Master A hat seine Anomalie im Band der Sonde (98..102).
+    b.belege("main", &master_a, 0, 12, 9.0, 0);
+    // Master B hat sie WOANDERS — Band 150..154.
+    b.belege_je_fenster("main2", &master_b, 200, 12, 0, |_| 9.0, (150, 154));
+    // Die Sonde drueckt ausschliesslich in 98..102.
+    b.belege("sonde0", &sonde, 100, 12, 9.0, 0);
+    let befunde = b.befunde();
+    protokoll("F8 zwei Master (A: Band 98..102, B: Band 150..154)", &befunde);
+    println!("   => starke Befunde: {}", stark(&befunde));
+    let sichtbar = b.snapshot();
+    println!("   => sources im Snapshot: {}",
+             sichtbar["sources"].as_array().map(Vec::len).unwrap_or(0));
+}
+
+// =========================================================================
+// G5-F8b — MASTER OHNE FENSTER (Fall 8)
+// =========================================================================
+#[test]
+fn f8b_master_ohne_fenster() {
+    let b = Buehne::schlank();
+    let sonde = adresse(2);
+    b.anmelden("main", &b.master, "main", Some(0));
+    b.anmelden("sonde0", &sonde, "passive_probe", Some(3));
+    b.marke(0);
+    // NUR die Sonde sendet. Der Master ist angemeldet, hat aber keinen Beleg.
+    b.belege("sonde0", &sonde, 100, 12, 9.0, 0);
+    let befunde = b.befunde();
+    protokoll("F8b Master angemeldet, aber ohne Beleg", &befunde);
