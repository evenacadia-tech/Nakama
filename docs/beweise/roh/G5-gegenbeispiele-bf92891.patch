+// =========================================================================
+// G5-F4 — KANALWECHSEL ZWISCHEN DEN FENSTERN (Fall 4)
+// =========================================================================
+//
+// Der Mixerkanal lebt im Deskriptor, nicht am Beleg
+// (hypothese_verdrahtung.rs:176–187). `aufnahmen_sammeln` liest ihn zum
+// Zeitpunkt der Rechnung — die Duplikaterkennung kennt deshalb nur den
+// LETZTEN Stand, nie die Kanalgeschichte der Fenster.
+#[test]
+fn f4_kanalwechsel_zwischen_den_fenstern() {
+    let b = Buehne::schlank();
+    let a = adresse(2);
+    let c = adresse(3);
+    b.anmelden("main", &b.master, "main", Some(0));
+    b.anmelden("sondeA", &a, "passive_probe", Some(7));
+    b.anmelden("sondeC", &c, "passive_probe", Some(7));
+    b.marke(0);
+    b.belege("main", &b.master, 0, 12, 9.0, 0);
+    // A fuehrt um 0,1 dB — sonst traennte sie nichts, und der Fall maesse
+    // nur den Gleichstandsriegel.
+    b.belege("sondeA", &a, 100, 12, 9.1, 0);
+    b.belege("sondeC", &c, 200, 12, 9.0, 0);
+    let vorher = b.befunde();
+    protokoll("F4 beide Sonden auf Mixerkanal 7", &vorher);
+    println!("   => starke Befunde: {}", stark(&vorher));
+
+    // Jetzt wechselt C den Kanal — ohne einen einzigen neuen MESSWERT.
+    b.deskriptor("sondeC", &c, "passive_probe", Some(9));
+    // Ein weiterer Beleg loest die Rechnung aus.
+    b.belege("sondeA", &a, 130, 1, 9.1, 12);
+    b.belege("sondeC", &c, 230, 1, 9.0, 12);
+    let nachher = b.befunde();
+    protokoll("F4 nach dem Kanalwechsel von C (7 -> 9), Messwerte unveraendert",
+              &nachher);
+    println!("   => starke Befunde: {}", stark(&nachher));
+}
