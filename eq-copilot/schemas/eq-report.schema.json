{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evenacadia.eq-copilot.report.v1",
  "title": "EQ-Copilot Report-Vertrag v1 (Claude-Ausgabe, Plan §6.3)",
  "description": "Der Renderer prüft Schema, Messungs-ID und jede Evidenz-ID. Ungültige oder veraltete Antworten werden nicht als Bericht angezeigt. band_hz außerhalb der Kandidatenbänder oder unbekannte evidence_ids ⇒ Ablehnung, ein Retry, dann lokaler Fallback (Plan §6.6).",
  "type": "object",
  "required": ["schema_version", "report_id", "based_on", "summary", "issues", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "report_id": { "type": "string", "format": "uuid" },
    "based_on": {
      "type": "object",
      "required": ["measurement_id", "target_id", "engine_version", "prompt_hash"],
      "additionalProperties": false,
      "properties": {
        "measurement_id": { "type": "string", "format": "uuid" },
        "target_id": { "type": "string" },
        "engine_version": { "type": "string" },
        "prompt_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "summary": { "type": "string", "maxLength": 600 },
    "issues": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["rank", "scope_ids", "kind", "band_hz", "evidence_ids", "interpretation", "confidence", "manual_trial"],
        "additionalProperties": false,
        "properties": {
          "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
          "scope_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "kind": { "enum": ["static_eq", "dynamic_eq", "level", "arrangement", "no_change"] },
          "band_hz": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": { "type": "number", "minimum": 10, "maximum": 30000 }
          },
          "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "interpretation": { "type": "string", "description": "Hypothese, nicht Messwert — Messsatz, Hypothese und Vorschlag bleiben getrennte Sätze" },
          "confidence": { "enum": ["high", "medium", "low"] },
          "manual_trial": {
            "type": "object",
            "required": ["tool_profile", "steps", "listen_for", "stop_if"],
            "additionalProperties": false,
            "properties": {
              "tool_profile": { "type": "string" },
              "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "listen_for": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "stop_if": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
