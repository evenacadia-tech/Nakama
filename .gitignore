eq-copilot/design/prisma/renders/stmap/probe-stmap.bin
# 72er-Sequenz-EXRs (247 MB; regenerierbar in ~5 min: --nur-stmap --dreh 72)
eq-copilot/design/prisma/renders/dreh-stmap/
# Dreh-Test-Screenshots (Beweislaeufe, fluechtig)
