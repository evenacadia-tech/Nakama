+    b.belege("main", &b.master, 0, 12, 9.0, 0);
+    b.belege("sondeA", &a, 100, 12, 9.2, 0);
+    b.belege("sondeC", &c, 200, 12, 9.1, 0);
+    b.belege("sondeD", &d, 300, 12, 9.0, 0);
